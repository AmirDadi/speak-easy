# Required: your Anthropic API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=

# Optional but recommended once deployed: a passcode so only you can use your API key.
# Enter the same value in the app under Profile → Passcode.
APP_PASSCODE=

# Optional: natural dialogue voices (Google Cloud Text-to-Speech, Chirp 3 HD).
# Without it, the app uses the phone's built-in voice.
GOOGLE_TTS_API_KEY=
